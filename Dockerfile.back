FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=120 \
    UV_HTTP_RETRIES=5 \
    PYTHONPATH=/app/App

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project --no-dev --group api \
    && uv cache clean

COPY alembic.ini ./
COPY migrations ./migrations
COPY App ./App

EXPOSE 8000

CMD ["uv", "run", "--no-sync", "--group", "api", "uvicorn", "App.main:app", "--host", "0.0.0.0", "--port", "8000"]
