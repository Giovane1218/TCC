# MySQL server.
# Docker Desktop: use host.docker.internal when MySQL runs on the host.
# Local execution without Docker: use 127.0.0.1.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=predictaidatab
MYSQL_USER=seu_usuario
MYSQL_PASSWORD=sua_senha

MYSQL_ROOT_PASSWORD=sua_senha_root

AUTH_SECRET_KEY=gere_uma_chave_secreta_com_32_caracteres_ou_mais

# Required only while the database has no administrator account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@email.com
ADMIN_PASSWORD=defina_uma_senha_com_12_caracteres_ou_mais
ADMIN_REGISTRO_PROFISSIONAL=ADMIN-001
ADMIN_CARGO=Administrador
ADMIN_UF_REGISTRO=SP
